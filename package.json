{
  "name": "web-slides-students",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "tsc -b && tsc -p functions && vite build",
    "lint": "eslint .",
    "preview": "vite build && wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply slides-db --local",
    "db:migrate": "wrangler d1 migrations apply slides-db --remote",
    "deploy": "pnpm build && wrangler pages deploy",
    "admin:create:local": "node scripts/create-admin.mjs",
    "admin:create": "node scripts/create-admin.mjs --remote"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
