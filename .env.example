# Copy to .env and fill in. .env is gitignored; never commit real values.
# Read by the pnpm scripts (scripts/env.mjs), not by the deployed app.

# --- Cloudflare (only needed for remote commands: deploy, db:migrate, admin:create) ---
# Account ID: Cloudflare dashboard → Workers & Pages → right sidebar.
CLOUDFLARE_ACCOUNT_ID=
# API token with "Cloudflare Pages: Edit" and "D1: Edit": dash.cloudflare.com/profile/api-tokens
# (Leave empty to use `pnpm wrangler login` instead.)
CLOUDFLARE_API_TOKEN=

# --- D1 database ---
D1_DATABASE_NAME=slides-db
# Printed by `pnpm wrangler d1 create slides-db`. Empty = local development only.
D1_DATABASE_ID=

# --- First super user (used by `pnpm admin:create` / `pnpm setup`) ---
SUPERUSER_EMAIL=
# Leave empty to be asked for it (hidden) when running the script.
SUPERUSER_PASSWORD=
